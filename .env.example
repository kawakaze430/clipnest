# Reference values. `npm run setup:local` creates random local credentials.
# Production secrets belong in an authorised secret store, never Git or chat.
POSTGRES_PASSWORD=
SESSION_SECRET=
PUBLIC_ORIGIN=https://downloads.example.com
DATABASE_URL=postgresql://clipnest_app:REPLACE@database.example.com:5432/clipnest
DB_TLS=verify-full
DB_CA_FILE=/run/secrets/rds-ca.pem
COOKIE_SECURE=true
ALLOW_REGISTRATION=false
INLINE_WORKER=false
TRUST_PROXY_HOPS=0
MAX_FILE_BYTES=262144000
MAX_DURATION_SECONDS=900
MAX_CONCURRENT_JOBS=2
DAILY_JOB_LIMIT=5
DAILY_BYTE_LIMIT=1310720000
FILE_TTL_MINUTES=30
ANALYSIS_TTL_MINUTES=10
SESSION_HOURS=24
AUTH_ATTEMPTS_PER_MINUTE=12
API_REQUESTS_PER_MINUTE=30
DB_POOL_MAX=10
YTDLP_USE_SYSTEM_CA=false
# CP-02 production adapters. Compose sets local development values separately.
STORAGE_BACKEND=s3
QUEUE_MODE=sqs
MAIL_MODE=ses
MAIL_FROM=
AWS_REGION=ap-south-1
S3_BUCKET=
MEDIA_BASE_URL=
CLOUDFRONT_KEY_PAIR_ID=
# Inject the PRIVATE KEY from Secrets Manager; never put it in a committed file.
CLOUDFRONT_PRIVATE_KEY=
SQS_QUEUE_URL=
SQS_DLQ_URL=
REQUIRE_EMAIL_VERIFICATION=true
JOB_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
ORPHAN_GRACE_MINUTES=60
MAX_QUEUED_JOBS=100
GLOBAL_DAILY_JOB_LIMIT=100
GLOBAL_DAILY_BYTE_LIMIT=10737418240
MAX_CONCURRENT_ANALYSES=1
JOB_TIMEOUT_SECONDS=1800
DEPLOYMENT_ENV=staging
# ECS may use DATABASE_SECRET_ARN instead of DATABASE_URL (mutually exclusive).
# DATABASE_SECRET_ARN=arn:aws:secretsmanager:...
# APP_ROLE=worker omits the private signing key from that worker's environment.
