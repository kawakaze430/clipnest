# Copy to an ignored terraform.tfvars; confirm owner inputs before applying.
region = "ap-south-1"
environment = "staging"
mail_from = "YOUR_VERIFIED_SES_SENDER"
alert_email = "YOUR_CONFIRMED_ALERT_ADDRESS"
monthly_budget_usd = 50 # Example only. Owner must select an affordable budget.
db_engine_version = "REPLACE_WITH_SUPPORTED_17_MINOR"
github_repository = "YOUR_OWNER/YOUR_REPOSITORY"
# Insert the PUBLIC PEM generated by npm run deployment:keys.
media_public_key_pem = <<KEY
-----BEGIN PUBLIC KEY-----
REPLACE_WITH_PUBLIC_KEY
-----END PUBLIC KEY-----
KEY
api_desired_count = 0
worker_desired_count = 0
enable_autoscaling = false

# Optional stronger viewer minimum: existing validated us-east-1 ACM certificate.
# custom_domain = "downloads.your-owned-domain.example"
# acm_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT:certificate/ID"
